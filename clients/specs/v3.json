{
  "openapi": "3.0.1",
  "info": {
    "title": "Universalis",
    "license": {
      "name": "MIT",
      "url": "https://github.com/Universalis-FFXIV/Universalis/blob/master/LICENSE"
    },
    "version": "v3"
  },
  "paths": {
    "/api/v3/game/data-centers": {
      "get": {
        "tags": [
          "Available data centers"
        ],
        "summary": "Returns all data centers supported by the API.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.DataCenter"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.DataCenter"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.DataCenter"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/misc/time-zones": {
      "get": {
        "tags": [
          "Available time zones"
        ],
        "summary": "Returns all installed time zones.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Miscellaneous.TimeZone"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Miscellaneous.TimeZone"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Miscellaneous.TimeZone"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/game/worlds": {
      "get": {
        "tags": [
          "Available worlds"
        ],
        "summary": "Returns the IDs and names of all worlds supported by the API.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.World"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.World"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Universalis.Application.Views.V3.Game.World"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/market/overview/{servers}/{itemId}": {
      "get": {
        "tags": [
          "Market board overview"
        ],
        "summary": "Retrieves an overview of the current market data for the provided item and servers. This contains\r\nthe current listings and a limited number of sales.",
        "parameters": [
          {
            "name": "servers",
            "in": "path",
            "description": "A comma-separated list of servers to search.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Universalis.Application.Controllers.Servers"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "description": "The ID of the item to look up.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data retrieved successfully.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.MarketOverview"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.MarketOverview"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.MarketOverview"
                }
              }
            }
          },
          "404": {
            "description": "A world/DC or the item requested is invalid.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/market/sales/{servers}/{itemId}": {
      "get": {
        "tags": [
          "Market board sales"
        ],
        "summary": "Retrieve the sales for the provided item on the requested servers.",
        "parameters": [
          {
            "name": "servers",
            "in": "path",
            "description": "A comma-separated list of servers to search.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Universalis.Application.Controllers.Servers"
            }
          },
          {
            "name": "itemId",
            "in": "path",
            "description": "The ID of the item to look up.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "A cursor into the desired page of sales.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data retrieved successfully.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.SalesPage"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.SalesPage"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.SalesPage"
                }
              }
            }
          },
          "404": {
            "description": "A world/DC or the item requested is invalid.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Microsoft.AspNetCore.Mvc.ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v3/game/marketable-items": {
      "get": {
        "tags": [
          "Marketable items"
        ],
        "summary": "Returns the set of marketable item IDs.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Microsoft.AspNetCore.Mvc.ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "Universalis.Application.Controllers.Servers": {
        "type": "string",
        "description": "A comma-separated list of world, data center, or region names."
      },
      "Universalis.Application.Views.V3.Game.DataCenter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "region": {
            "type": "string",
            "nullable": true
          },
          "worlds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Game.World": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.Creator": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A SHA256 hash of the creator's ID.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "The creator's character name.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.Listing": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "description": "A SHA256 hash of the ID of this listing. Due to some current client-side bugs, this will almost always be null.",
            "nullable": true
          },
          "world": {
            "type": "integer",
            "description": "The listing world's ID.",
            "format": "int32"
          },
          "reviewedAt": {
            "type": "integer",
            "description": "The time that this listing was posted by its seller, in milliseconds since the UNIX epoch.",
            "format": "int64"
          },
          "price": {
            "type": "number",
            "description": "The price per unit sold. This is the result of the taxed total divided by the quantity, and so it\r\nwill be a decimal value.",
            "format": "double"
          },
          "quantity": {
            "type": "integer",
            "description": "The stack size sold.",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "description": "The total price of the listing.",
            "format": "int32"
          },
          "hq": {
            "type": "boolean",
            "description": "Whether or not the item is high-quality."
          },
          "dye": {
            "type": "integer",
            "description": "The ID of the dye color (from the Stain sheet) on this item.",
            "format": "int32"
          },
          "creator": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Creator"
              }
            ],
            "description": "The item's creator/crafter, if applicable. May be null for items with no creator.",
            "nullable": true
          },
          "materia": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The item IDs of the materia on this item.",
            "nullable": true
          },
          "onMannequin": {
            "type": "boolean",
            "description": "Whether or not the item is being sold on a mannequin."
          },
          "retainer": {
            "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Retainer"
          },
          "seller": {
            "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Seller"
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.MarketOverview": {
        "type": "object",
        "properties": {
          "item": {
            "type": "integer",
            "description": "The item's ID.",
            "format": "int32"
          },
          "updatedAt": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "description": "The time that this item was last updated on each world requested, in milliseconds since the UNIX epoch.\r\nIf an item has never been checked, the timestamp will be null.",
            "nullable": true
          },
          "listings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Listing"
            },
            "description": "The current listings.",
            "nullable": true
          },
          "sales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Sale"
            },
            "description": "The known sales.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.Retainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A SHA256 hash of the retainer's ID.",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "The retainer's name.",
            "nullable": true
          },
          "city": {
            "type": "integer",
            "description": "The city ID of the retainer.\r\nLimsa Lominsa = 1\r\nGridania = 2\r\nUl'dah = 3\r\nIshgard = 4\r\nKugane = 7\r\nCrystarium = 10",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.Sale": {
        "type": "object",
        "properties": {
          "world": {
            "type": "integer",
            "description": "The sale world's ID.",
            "format": "int32"
          },
          "hq": {
            "type": "boolean",
            "description": "Whether or not the item was high-quality."
          },
          "price": {
            "type": "integer",
            "description": "The untaxed price per unit sold.",
            "format": "int32"
          },
          "quantity": {
            "type": "integer",
            "description": "The stack size sold. This may be null.",
            "format": "int32",
            "nullable": true
          },
          "saleTime": {
            "type": "integer",
            "description": "The sale time, in milliseconds since the UNIX epoch.",
            "format": "int64"
          },
          "onMannequin": {
            "type": "boolean",
            "description": "Whether or not this was purchased from a mannequin. This may be null.",
            "nullable": true
          },
          "buyer": {
            "type": "string",
            "description": "The buyer's name. This may be null.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.SalesPage": {
        "type": "object",
        "properties": {
          "sales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Universalis.Application.Views.V3.Market.Sale"
            },
            "description": "The sales on the current page. The number of sales that will be returned is not defined.",
            "nullable": true
          },
          "next": {
            "type": "string",
            "description": "The cursor into the next page of sales. This will be null when there are no more sales to return.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Market.Seller": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "A SHA256 hash of the seller's ID.",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Universalis.Application.Views.V3.Miscellaneous.TimeZone": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "offset": {
            "type": "number",
            "format": "double"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}